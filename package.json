{
  "name": "netbanking-ui-testing",
  "version": "1.0.0",
  "description": "Playwright + TypeScript test suite for a fictional Arya Bank net banking app with planted UI bugs",
  "scripts": {
    "start": "node app/server.mjs",
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium --project=mobile-chrome",
    "typecheck": "tsc --noEmit",
    "bug-hunt": "node scripts/bug-hunt.mjs",
    "report": "playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byshivam/netbanking-ui-testing.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/byshivam/netbanking-ui-testing/issues"
  },
  "homepage": "https://github.com/byshivam/netbanking-ui-testing#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
